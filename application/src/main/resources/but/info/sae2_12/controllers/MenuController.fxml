<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>

<MenuBar fx:id="menuBar" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="but.info.sae2_12.controllers.MenuController">
    <menus>
        <Menu mnemonicParsing="false" text="File">
            <items>
                <MenuItem fx:id="charger" mnemonicParsing="false" onAction="#onCharger" text="Open…" />
                <SeparatorMenuItem mnemonicParsing="false" />
                <MenuItem mnemonicParsing="false" text="Close" />
                <MenuItem fx:id="sauvegarderSous" mnemonicParsing="false" onAction="#onsauvegarderSous" text="Save As…" />
                <SeparatorMenuItem mnemonicParsing="false" />
                <MenuItem fx:id="quitter" mnemonicParsing="false" onAction="#onQuit" text="Quit" />
            </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Help">
            <items>
                <MenuItem fx:id="aPropos" mnemonicParsing="false" onAction="#onAPropos" text="About" />
            </items>
        </Menu>
    </menus>
</MenuBar>